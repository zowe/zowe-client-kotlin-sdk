{
  "$schema": "./zowe.schema.json",
  "profiles": {
    "zosmf": {
      "type": "zosmf",
      "properties": {
        "port": 443
      },
      "secure": []
    },
    "lpar1": {
      "properties": {
        "host": "example.host1"
      },
      "profiles": {
        "section1": {
          "properties": {
            "basePath": "/api"
          },
          "profiles": {
            "section2": {
              "profiles": {
                "emptyZosmfProfile": {
                  "secure": [
                    "user",
                    "password"
                  ]
                }
              }
            },
            "testParametersProfile": {
              "type": "zosmf",
              "properties": {
                "host": "example.host2",
                "port": 443,
                "rejectUnauthorized": false,
                "protocol": "https",
                "encoding": 37,
                "responseTimeout": 600,
                "user": "zosmfUser",
                "password": "zosmfPassword"
              }
            }
          }
        },
        "zosmf": {
          "type": "zosmf",
          "properties": {
            "port": 10443
          },
          "secure": []
        },
        "base": {
          "type": "base",
          "secure": [
            "user",
            "password"
          ]
        }
      }
    },
    "tso": {
      "type": "tso",
      "properties": {
        "account": "",
        "codePage": "1047",
        "logonProcedure": "IZUFPROC"
      },
      "secure": []
    },
    "ssh": {
      "type": "ssh",
      "properties": {
        "port": 22
      },
      "secure": []
    },
    "base": {
      "type": "base",
      "properties": {
        "host": "example.host",
        "rejectUnauthorized": true
      },
      "secure": [
        "user",
        "password"
      ]
    }
  },
  "defaults": {
    "zosmf": "lpar1.zosmf",
    "tso": "tso",
    "ssh": "ssh",
    "base": "base"
  }
}